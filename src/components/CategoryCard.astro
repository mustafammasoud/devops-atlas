---
import CategoryIcon from './CategoryIcon.astro';
import type { Category } from '../data/categories';
import { articleCount } from '../utils/docs';

interface Props {
  category: Category;
  /** Number of published articles in this category (computed at build time). */
  count: number;
}

const { category, count } = Astro.props;
const planned = count === 0;

/** Article-count copy shown on the card. */
const countText = articleCount(count);
---

<li class="border-t border-border">
  <a
    href={`/docs/${category.id}`}
    class="area-card group flex items-start gap-4 py-5 transition-colors"
  >
    <CategoryIcon
      name={category.icon}
      class="mt-0.5 h-5 w-5 shrink-0 text-muted transition-colors group-hover:text-accent"
    />

    <span class="min-w-0 flex-1">
      <span
        class="block text-[0.975rem] font-semibold tracking-tight transition-colors group-hover:text-accent"
        lang="en"
      >
        {category.label}
      </span>
      <span
        class="mt-1 block text-sm leading-relaxed text-muted"
      >
        {category.descriptionEn}
      </span>
    </span>

    {
      planned ? (
        <span
          class="mt-0.5 shrink-0 rounded-full bg-surface-2 px-2.5 py-0.5 text-xs text-muted"
        >
          Planned
        </span>
      ) : (
        <span class="mt-0.5 shrink-0 text-xs text-muted tabular-nums">
          {countText}
        </span>
      )
    }

    <svg
      class="mt-1 h-4 w-4 shrink-0 text-transparent transition-colors group-hover:text-accent"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M7 17 17 7M9 7h8v8"></path>
    </svg>
  </a>
</li>
