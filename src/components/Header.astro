---
import ThemeToggle from './ThemeToggle.astro';
import Search from './Search.astro';
import SocialIcon from './SocialIcon.astro';

/** Highlight the "Docs" nav link on documentation routes. */
const isDocs = Astro.url.pathname.startsWith('/docs');
---

<header
  class="sticky top-0 z-40 border-b border-border bg-bg/90 backdrop-blur supports-[backdrop-filter]:bg-bg/75"
>
  <div class="mx-auto flex h-14 max-w-screen-2xl items-center gap-3 px-4 sm:gap-4">
    <!-- Left: logo + primary nav -->
    <div class="flex flex-1 items-center gap-3">
      <a href="/" class="flex shrink-0 items-center gap-2.5 font-semibold tracking-tight" dir="ltr">
        <!-- Atlas Plate mark: monochrome frame + route, accent terminus node. -->
        <svg class="h-7 w-7" viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <rect
            x="3.25"
            y="3.25"
            width="25.5"
            height="25.5"
            rx="6.5"
            stroke="currentColor"
            stroke-width="2.5"
          />
          <path
            d="M10 23.5V16Q10 14 12 14H18.75"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <circle cx="21.5" cy="14" r="3" class="fill-accent" />
        </svg>
        <span class="hidden sm:inline">Ops Handbook</span>
      </a>

      <nav
        aria-label="Main navigation"
        class="hidden sm:block"
      >
        <a
          href="/docs"
          aria-current={isDocs ? 'page' : undefined}
          class="nav-link rounded-md px-2.5 py-1.5 text-sm font-medium transition-colors"
        >
          Docs
        </a>
      </nav>
    </div>

    <!-- Center: search — grows with the viewport, capped, centered between
         the left and right regions (equal flex on both sides). -->
    <div class="mx-auto flex min-w-0 flex-1 justify-center max-w-[32rem] sm:block">
      <Search />
    </div>

    <!-- Right: actions -->
    <div class="flex flex-1 items-center justify-end gap-2">
      <a
        href="https://github.com/mustafammasoud/ops-handbook"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub repository"
        title="GitHub repository"
        class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-border bg-surface text-muted transition-colors hover:border-accent/50 hover:text-text"
      >
        <SocialIcon name="github" class="h-5 w-5 shrink-0" />
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>
