---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const items = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
---

{
  items.length > 0 && (
    <nav data-toc aria-label="On this page" class="text-sm">
      <p class="eyebrow mb-2">
        On this page
      </p>
      <ul class="space-y-1 border-s border-border ps-3">
        {items.map((heading) => (
          <li class={heading.depth === 3 ? 'ps-3' : ''}>
            <a
              href={`#${heading.slug}`}
              class="toc-link block py-1 text-muted transition-colors hover:text-accent-ink"
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<script>
  // Scroll-spy: highlights exactly one section while reading.
  // IntersectionObserver does the work — no per-scroll math. The active
  // link persists between headings (empty observer windows keep the last
  // value), the last heading wins at the page bottom, and plain anchor
  // links keep working (and stay keyboard-accessible) without JavaScript.
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('nav[data-toc] a.toc-link'),
  );
  const ids = links.map((link) => decodeURIComponent(link.hash.slice(1)));
  const targets = ids
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  if (links.length > 0 && targets.length > 0) {
    const visible = new Set<string>();
    let activeId: string | null = null;

    const atPageBottom = (): boolean =>
      window.innerHeight + window.scrollY >=
      document.documentElement.scrollHeight - 4;

    const setActive = (id: string | null): void => {
      if (id === activeId) return;
      activeId = id;
      links.forEach((link, index) => {
        const active = ids[index] === id;
        link.classList.toggle('is-active', active);
        if (active) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) visible.add(entry.target.id);
          else visible.delete(entry.target.id);
        }
        // First heading currently in the reading band …
        let nextId = ids.find((id) => visible.has(id));
        // … else last heading when scrolled to the bottom …
        if (!nextId && atPageBottom()) nextId = ids[ids.length - 1];
        // … else keep the previous highlight; before the first band, start
        // with the first section so exactly one is always current.
        if (!nextId) nextId = activeId ?? ids[0];
        setActive(nextId);
      },
      { rootMargin: '-96px 0px -60% 0px', threshold: 0 },
    );
    targets.forEach((target) => observer.observe(target));
    setActive(ids[0]);
  }
</script>
