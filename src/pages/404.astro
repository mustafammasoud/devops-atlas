---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
---

<BaseLayout title="الصفحة غير موجودة | DevOps Atlas">
  <Header />
  <main id="main" class="mx-auto w-full max-w-screen-2xl px-4 py-16 text-center">
    <p class="text-sm text-muted" dir="ltr">404</p>
    <h1 class="mt-2 text-2xl font-bold">الصفحة غير موجودة</h1>
    <p class="mt-3 text-muted">ربما تمت إزالة الصفحة أو تغيّر رابطها.</p>
    <a href="/" class="mt-6 inline-block rounded-md bg-accent px-4 py-2 text-sm font-semibold text-accent-contrast">
      العودة إلى الرئيسية
    </a>
  </main>
</BaseLayout>
