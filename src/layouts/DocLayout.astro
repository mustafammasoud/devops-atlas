---
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import TableOfContents from '../components/TableOfContents.astro';
import DocEnhancements from '../components/DocEnhancements.astro';
import MermaidRuntime from '../components/MermaidRuntime.astro';
import { categoryLabel, levelLabel } from '../data/categories';
import { docPath, sortedDocs } from '../utils/docs';
import type { CollectionEntry } from 'astro:content';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  entry: CollectionEntry<'docs'>;
  headings: Heading[];
}

const { entry, headings } = Astro.props;
const { title, description, category, level, tags, language } = entry.data;
const dir = language === 'ar' ? 'rtl' : 'ltr';

// Prev/next across the whole documentation in canonical order.
const ordered = sortedDocs(await getCollection('docs', ({ data }) => !data.draft));
const position = ordered.findIndex((doc) => doc.id === entry.id);
const previous = position > 0 ? ordered[position - 1] : null;
const next = position >= 0 && position < ordered.length - 1 ? ordered[position + 1] : null;

const pageTitle = title === 'DevOps Atlas' ? 'DevOps Atlas' : `${title} | DevOps Atlas`;
---

<BaseLayout title={pageTitle} description={description} lang={language} dir={dir}>
  <Header />

  <div class="mx-auto flex w-full max-w-screen-2xl gap-6 px-4">
    <!-- Sidebar (desktop) -->
    <aside
      class="sticky top-14 hidden max-h-[calc(100vh-3.5rem)] w-64 shrink-0 overflow-y-auto py-6 lg:block"
    >
      <Sidebar currentId={entry.id} />
    </aside>

    <main id="main" class="min-w-0 flex-1 py-6 lg:py-10">
      <!-- Sidebar (mobile) -->
      <details class="mb-6 rounded-md border border-border bg-surface lg:hidden">
        <summary class="cursor-pointer px-4 py-2.5 text-sm font-semibold">المحتويات</summary>
        <div class="border-t border-border p-4">
          <Sidebar currentId={entry.id} />
        </div>
      </details>

      <!-- Breadcrumbs -->
      <nav aria-label="مسار التنقل" class="mb-4 text-sm text-muted">
        <ol class="flex flex-wrap items-center gap-1.5">
          <li><a href="/" class="hover:text-accent">الرئيسية</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/docs" class="hover:text-accent">الوثائق</a></li>
          <li aria-hidden="true">/</li>
          <li>
            <a href={`/docs#cat-${category}`} class="hover:text-accent">
              {categoryLabel(category)}
            </a>
          </li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="font-medium text-text">{title}</li>
        </ol>
      </nav>

      <header class="mb-8 border-b border-border pb-6">
        <p class="mb-2 text-sm text-muted">
          <span>{categoryLabel(category)}</span>
          <span aria-hidden="true"> · </span>
          <span>{levelLabel(level)}</span>
        </p>
        <h1 class="text-2xl font-bold leading-snug sm:text-3xl">{title}</h1>
        {
          description && (
            <p class="mt-3 max-w-3xl text-muted leading-relaxed">{description}</p>
          )
        }
        {
          tags.length > 0 && (
            <ul class="mt-4 flex flex-wrap gap-2">
              {tags.map((tag) => (
                <li
                  class="rounded-full border border-border bg-surface px-2.5 py-0.5 text-xs text-muted"
                  dir="ltr"
                >
                  {tag}
                </li>
              ))}
            </ul>
          )
        }
      </header>

      <!-- The document region owns its text direction. -->
      <article class="prose max-w-3xl" dir={dir}>
        <slot />
      </article>

      <!-- Prev / next -->
      <nav
        class="mt-12 grid max-w-3xl gap-4 border-t border-border pt-6 sm:grid-cols-2"
        aria-label="التنقل بين الصفحات"
      >
        {
          previous ? (
            <a
              href={docPath(previous.id)}
              class="rounded-lg border border-border p-4 transition-colors hover:border-accent"
            >
              <span class="text-xs text-muted">الصفحة السابقة</span>
              <span class="mt-1 block font-semibold">{previous.data.title}</span>
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a
              href={docPath(next.id)}
              class="rounded-lg border border-border p-4 text-end transition-colors hover:border-accent sm:col-start-2"
            >
              <span class="text-xs text-muted">الصفحة التالية</span>
              <span class="mt-1 block font-semibold">{next.data.title}</span>
            </a>
          )
        }
      </nav>
    </main>

    <!-- Table of contents (desktop) -->
    <aside
      class="sticky top-14 hidden max-h-[calc(100vh-3.5rem)] w-56 shrink-0 overflow-y-auto py-10 xl:block"
    >
      <TableOfContents headings={headings} />
    </aside>
  </div>

  <DocEnhancements />
  <MermaidRuntime />
</BaseLayout>
