---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import {
  categories,
  categoryLabel,
  canonicalCategoryId,
  toolLabel,
} from '../../data/categories';
import { docPath, docTool, sortedDocs } from '../../utils/docs';

const docs = sortedDocs(await getCollection('docs', ({ data }) => !data.draft));

const knownIds = new Set(categories.map((category) => category.id));
const orderedIds = [
  ...categories.map((category) => category.id),
  ...new Set(
    docs
      .map((doc) => canonicalCategoryId(doc.data.category))
      .filter((id) => !knownIds.has(id)),
  ),
];

const groups = orderedIds
  .map((id) => ({
    id,
    label: categoryLabel(id),
    entries: docs.filter((doc) => canonicalCategoryId(doc.data.category) === id),
  }))
  .filter((group) => group.entries.length > 0);
---

<BaseLayout
  title="All Documentation | DevOps Atlas"
  titleAr="كل الوثائق | DevOps Atlas"
  description="Index of all DevOps Atlas documentation."
  descriptionAr="فهرس جميع وثائق DevOps Atlas."
>
  <Header />

  <main id="main" class="mx-auto w-full max-w-screen-2xl px-4 py-10">
    <h1 class="text-2xl font-semibold tracking-tight" data-ar="كل الوثائق">
      All Documentation
    </h1>

    <div class="mt-8 space-y-10">
      {
        groups.map((group) => (
          <section aria-labelledby={`cat-${group.id}`}>
            <h2 id={`cat-${group.id}`} class="mb-3 text-lg font-semibold">
              <a
                href={`/docs/${group.id}`}
                class="transition-colors hover:text-accent"
                lang="en"
              >
                {group.label}
              </a>
            </h2>
            <ul class="divide-y divide-border rounded-md border border-border">
              {group.entries.map((entry) => (
                <li>
                  <a
                    href={docPath(entry.id)}
                    class="flex items-center justify-between gap-4 px-4 py-3 transition-colors hover:bg-surface"
                  >
                    <span class="font-medium">{entry.data.title}</span>
                    <span class="flex items-center gap-3">
                      {docTool(entry) && (
                        <span
                          class="rounded border border-border bg-surface px-2 py-0.5 text-xs text-muted"
                          lang="en"
                        >
                          {toolLabel(docTool(entry)!)}
                        </span>
                      )}
                      <span class="shrink-0 text-sm text-muted">{entry.data.description}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </main>
</BaseLayout>
