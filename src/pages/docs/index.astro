---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import CategoryCard from '../../components/CategoryCard.astro';
import { categories } from '../../data/categories';
import { docCategory, sortedDocs } from '../../utils/docs';

const docs = sortedDocs(await getCollection('docs', ({ data }) => !data.draft));

const counts = new Map<string, number>();
for (const doc of docs) {
  const cat = docCategory(doc);
  counts.set(cat, (counts.get(cat) ?? 0) + 1);
}
---

<BaseLayout
  title="Documentation | Ops Handbook"
  titleAr="الوثائق | Ops Handbook"
  description="Explore the Ops Handbook knowledge base."
  descriptionAr="استكشف قاعدة معرفية Ops Handbook."
>
  <Header />

  <main id="main" class="mx-auto w-full max-w-screen-2xl px-4 py-10">
    <section class="max-w-2xl">
      <h1
        class="text-2xl font-semibold tracking-tight sm:text-3xl"
        data-ar="الوثائق"
      >
        Documentation
      </h1>
      <p class="mt-3 text-lg leading-relaxed text-muted" data-ar="استكشف قاعدة معرفية Ops Handbook.">
        Explore the Ops Handbook knowledge base.
      </p>
    </section>

    <section
      class="mt-10 border-t border-border pt-8"
      aria-labelledby="areas-heading"
    >
      <h2
        id="areas-heading"
        class="mb-4 text-lg font-semibold"
        data-ar="أقسام التوثيق"
      >
        Documentation Areas
      </h2>

      <ul class="grid border-b border-border sm:grid-cols-2 sm:gap-x-12">
        {
          categories.map((category) => (
            <CategoryCard
              category={category}
              count={counts.get(category.id) ?? 0}
            />
          ))
        }
      </ul>
    </section>
  </main>
</BaseLayout>
