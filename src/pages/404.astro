---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
---

<BaseLayout
  title="Page Not Found | DevOps Atlas"
  titleAr="الصفحة غير موجودة | DevOps Atlas"
>
  <Header />
  <main id="main" class="mx-auto w-full max-w-screen-2xl px-4 py-20 text-center">
    <p class="text-sm text-muted tabular-nums" dir="ltr">404</p>
    <h1 class="mt-2 text-2xl font-semibold tracking-tight" data-ar="الصفحة غير موجودة">
      Page not found
    </h1>
    <p class="mt-3 text-muted" data-ar="ربما تمت إزالة الصفحة أو تغيّر رابطها.">
      The page may have been removed or the link changed.
    </p>
    <a
      href="/"
      class="mt-8 inline-block rounded-md bg-accent px-4 py-2.5 text-sm font-medium text-accent-contrast transition-opacity hover:opacity-90"
      data-ar="العودة إلى الرئيسية"
    >
      Back to home
    </a>
  </main>
</BaseLayout>
