---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import CategoryIcon from '../../components/CategoryIcon.astro';
import {
  categories,
  getCategory,
  categoryLabel,
  canonicalCategoryId,
  toolLabel,
  levelLabel,
  levelLabelAr,
} from '../../data/categories';
import { docPath, docTool, sortedDocs } from '../../utils/docs';

export async function getStaticPaths() {
  // Every registered category gets a page (even while empty/planned),
  // plus any category id that only exists in content frontmatter.
  const docs = await getCollection('docs', ({ data }) => !data.draft);
  const ids = new Set<string>([
    ...categories.map((category) => category.id),
    ...docs.map((doc) => canonicalCategoryId(doc.data.category)),
  ]);
  return [...ids].map((category) => ({ params: { category } }));
}

const { category: rawCategoryId } = Astro.params;
const categoryId = canonicalCategoryId(rawCategoryId!);

const docs = sortedDocs(
  (await getCollection('docs', ({ data }) => !data.draft)).filter(
    (doc) => canonicalCategoryId(doc.data.category) === categoryId,
  ),
);

const category = getCategory(categoryId!);
const label = categoryLabel(categoryId!);
const descriptionEn = category?.descriptionEn ?? `The ${label} section of the documentation.`;
const descriptionAr = category?.descriptionAr ?? `قسم ${label} في الوثائق.`;
const count = docs.length;

// Topic count copy: English default + Arabic variant.
const countEn = count === 1 ? '1 topic' : `${count} topics`;
const countAr =
  count === 0
    ? 'لا مواضيع بعد'
    : count === 1
      ? 'موضوع واحد'
      : count === 2
        ? 'موضوعان'
        : count <= 10
          ? `${count} مواضيع`
          : `${count} موضوعاً`;

// Difficulty range from the levels actually present (metadata only).
const LEVELS = ['beginner', 'intermediate', 'advanced'] as const;
const presentLevels = LEVELS.filter((level) => docs.some((doc) => doc.data.level === level));
const firstLevel = presentLevels[0];
const lastLevel = presentLevels[presentLevels.length - 1];
const levelRangeEn =
  presentLevels.length === 0
    ? null
    : presentLevels.length === 1
      ? `Level: ${levelLabel(firstLevel)}`
      : `Level: ${levelLabel(firstLevel)} → ${levelLabel(lastLevel)}`;
const levelRangeAr =
  presentLevels.length === 0
    ? null
    : presentLevels.length === 1
      ? `المستوى: ${levelLabelAr(firstLevel)}`
      : `المستوى: ${levelLabelAr(firstLevel)} ← ${levelLabelAr(lastLevel)}`;

// Learning structure: group by level, keep `order` inside each group.
const structure = presentLevels.map((level) => ({
  level,
  label: levelLabel(level),
  labelAr: levelLabelAr(level),
  entries: docs.filter((doc) => doc.data.level === level),
}));

const pageTitle = `${label} | DevOps Atlas`;
---

<BaseLayout
  title={pageTitle}
  description={descriptionEn}
  descriptionAr={descriptionAr}
>
  <Header />

  <main id="main" class="mx-auto w-full max-w-screen-2xl px-4 py-8">
    <!-- Breadcrumbs -->
    <nav
      aria-label="Breadcrumb"
      data-ar-aria="مسار التنقل"
      class="mb-6 text-sm text-muted"
    >
      <ol class="flex flex-wrap items-center gap-1.5">
        <li>
          <a href="/" class="hover:text-accent" data-ar="الرئيسية">Home</a>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <a href="/docs" class="hover:text-accent" data-ar="الوثائق">Docs</a>
        </li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="font-medium text-text" lang="en">{label}</li>
      </ol>
    </nav>

    <!-- Category header -->
    <header class="border-b border-border pb-8">
      <div class="flex items-start gap-4">
        <span
          class="grid h-12 w-12 shrink-0 place-items-center rounded-md border border-border bg-surface text-muted"
        >
          {
            category ? (
              <CategoryIcon name={category.icon} class="h-7 w-7" />
            ) : (
              <CategoryIcon name="layers" class="h-7 w-7" />
            )
          }
        </span>
        <div class="min-w-0">
          <h1
            class="text-2xl font-semibold leading-snug tracking-tight sm:text-3xl"
            lang="en"
          >
            {label}
          </h1>
        </div>
      </div>

      <p class="mt-4 max-w-3xl leading-relaxed text-muted" data-ar={descriptionAr}>
        {descriptionEn}
      </p>

      <p class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-muted">
        {
          count === 0 ? (
            <span data-ar={countAr}>No topics yet</span>
          ) : (
            <span class="tabular-nums" data-ar={countAr}>
              {countEn}
            </span>
          )
        }
        {
          levelRangeEn && (
            <>
              <span aria-hidden="true">·</span>
              <span data-ar={levelRangeAr}>{levelRangeEn}</span>
            </>
          )
        }
      </p>
    </header>

    {
      count === 0 ? (
        <section class="mt-10 max-w-2xl rounded-md border border-border bg-surface p-8 text-center">
          <p class="font-medium" data-ar="لا توجد مواضيع بعد">
            No topics yet
          </p>
          <p class="mt-2 text-sm leading-relaxed text-muted" data-ar="هذا القسم مخطط له ضمن خارطة المحتوى وسيُملأ تدريجياً.">
            This section is planned in the content roadmap and will be filled in gradually.
          </p>
          <div class="mt-5 flex flex-wrap justify-center gap-3 text-sm">
            <a
              href="/docs"
              class="rounded-md border border-border bg-bg px-3.5 py-2 font-medium transition-colors hover:border-accent/50 hover:text-accent"
              data-ar="تصفّح الوثائق المتاحة"
            >
              Browse available documentation
            </a>
            <a
              href="https://github.com/mustafammasoud/devops-atlas/blob/main/docs-roadmap.md"
              target="_blank"
              rel="noopener"
              class="rounded-md px-3.5 py-2 font-medium text-muted transition-colors hover:text-accent"
              data-ar="خارطة المحتوى ↗"
            >
              Content roadmap ↗
            </a>
          </div>
        </section>
      ) : (
        <>
          <section class="mt-10" aria-labelledby="structure-heading">
            <h2
              id="structure-heading"
              class="mb-4 text-lg font-semibold"
              data-ar="البنية التعليمية"
            >
              Learning structure
            </h2>
            <div class="grid gap-4 md:grid-cols-3">
              {structure.map((group) => (
                <div class="rounded-md border border-border bg-surface p-4">
                  <h3 class="mb-3 flex items-center justify-between text-sm font-semibold">
                    <span data-ar={group.labelAr}>{group.label}</span>
                    <span class="rounded-full bg-surface-2 px-2 py-0.5 text-xs font-normal text-muted tabular-nums">
                      {group.entries.length}
                    </span>
                  </h3>
                  <ol class="space-y-2">
                    {group.entries.map((doc, index) => (
                      <li>
                        <a
                          href={docPath(doc.id)}
                          class="flex items-baseline gap-2 text-sm text-text/90 transition-colors hover:text-accent"
                        >
                          <span class="ltr shrink-0 text-xs text-muted tabular-nums">
                            {String(index + 1).padStart(2, '0')}
                          </span>
                          <span class="leading-snug">{doc.data.title}</span>
                        </a>
                      </li>
                    ))}
                  </ol>
                </div>
              ))}
            </div>
          </section>

          <section class="mt-10" aria-labelledby="topics-heading">
            <h2
              id="topics-heading"
              class="mb-4 text-lg font-semibold"
              data-ar="قائمة المواضيع"
            >
              Topics list
            </h2>
            <ol class="divide-y divide-border rounded-md border border-border">
              {docs.map((doc, index) => (
                <li>
                  <a
                    href={docPath(doc.id)}
                    class="flex items-center justify-between gap-4 px-4 py-3 transition-colors hover:bg-surface"
                  >
                    <span class="flex min-w-0 items-baseline gap-3">
                      <span class="ltr shrink-0 text-xs text-muted tabular-nums">
                        {String(index + 1).padStart(2, '0')}
                      </span>
                      <span class="min-w-0">
                        <span class="block font-medium">{doc.data.title}</span>
                        {doc.data.description && (
                          <span class="mt-0.5 block truncate text-sm text-muted">
                            {doc.data.description}
                          </span>
                        )}
                      </span>
                    </span>
                    <span class="flex shrink-0 items-center gap-3">
                      {
                        docTool(doc) && (
                          <span
                            class="rounded border border-border bg-surface px-2 py-0.5 text-xs text-muted"
                            lang="en"
                          >
                            {toolLabel(docTool(doc)!)}
                          </span>
                        )
                      }
                      <span
                        class="rounded-full border border-border bg-surface px-2.5 py-0.5 text-xs text-muted"
                        data-ar={levelLabelAr(doc.data.level)}
                      >
                        {levelLabel(doc.data.level)}
                      </span>
                      <span class="ltr text-xs text-muted tabular-nums">#{doc.data.order}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        </>
      )
    }
  </main>
</BaseLayout>
